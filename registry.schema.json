{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Scrollport/search-seo-skills/blob/main/registry.schema.json",
  "title": "Scrollport Skill registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "repository": {
      "const": "https://github.com/Scrollport/search-seo-skills"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "status",
          "customer_proven"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "verified"
            ]
          },
          "customer_proven": {
            "type": "boolean"
          }
        }
      }
    },
    "draft_revisions": {
      "description": "Non-installable replacement revisions for existing verified Skills. They never enter exports.",
      "type": "array",
      "items": {
        "$ref": "#/properties/skills/items"
      }
    }
  }
}
